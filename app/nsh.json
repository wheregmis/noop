{
  "name": "Noop",
  "id": "dev.noop.app",
  "version": "0.1.0",
  "build": 1,
  "updater": {
    "github": "huacnlee/noop",
    "packages": {
      "roots": [
        "SJl1kuuXiy0WqZM03S0Q16OIGNX7e+RTI8H5Flk8JLo="
      ]
    }
  },
  "appearance": "system",
  "theme": "theme.json",
  "web": {
    "host": "./host.js"
  },
  "capabilities": {
    "clipboard": true,
    "statusBar": true,
    "network": {
      "hosts": [
        "*"
      ]
    },
    "host": [
      "page",
      "pushState",
      "pushEnable",
      "pushDisable",
      "setSession",
      "setBadge",
      "clearNotifications",
      "vibrate",
      "speechState",
      "speechStart",
      "speechStop",
      "speechAbort"
    ],
    "picker": true,
    "speech": true,
    "notifications": true,
    "fs": {
      "read": [
        "${homeDir}"
      ]
    },
    "openUrl": {
      "schemes": [
        "https",
        "mailto"
      ]
    }
  },
  "icon": "icon.png"
}
